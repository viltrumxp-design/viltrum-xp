{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "viltrum-xp",
  "main": "./worker.js",
  "compatibility_date": "2026-09-18",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "viltrum-xp-bookings",
      "database_id": "36b50eca-7444-4b33-b17e-29523eb08cb3"
    }
  ]
}
